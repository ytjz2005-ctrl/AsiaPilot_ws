          Unreliable: false
          Value: true
        - Class: rviz/Marker
          Enabled: true
          Marker Topic: /odom_visualization/robot
          Name: Marker
          Namespaces:
            mesh: true
          Queue Size: 100
          Value: true
      Enabled: true
      Name: State
    - Class: rviz/Group
      Displays:
        - Class: rviz/Group
          Displays:
            - Class: rviz/Image
