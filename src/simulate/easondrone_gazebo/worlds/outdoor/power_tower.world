<sdf version='1.6'>
    <world name='default'>
        <light name='sun' type='directional'>
            <cast_shadows>1</cast_shadows>
            <pose frame=''>0 0 10 0 -0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <!-- A ground plane -->
        <model name='asphalt_plane'>
          <static>1</static>
          <link name='link'>
            <collision name='collision'>
              <geometry>
                <box>
                  <size>400 20 0.05</size>
                </box>
              </geometry>
              <max_contacts>10</max_contacts>
              <surface>
                <bounce/>
                <friction>
                  <ode/>
                </friction>
                <contact>
                  <ode/>
                </contact>
              </surface>
            </collision>
            <visual name='visual'>
              <cast_shadows>0</cast_shadows>
              <geometry>
                <box>
                  <size>400 80 0.05</size>
                </box>
              </geometry>
              <material>
                <script>
                  <uri>file://media/materials/scripts/gazebo.material</uri>
                  <name>Gazebo/Grass</name>
                </script>
                <ambient>1 1 1 1</ambient>
              </material>
            </visual>
            <velocity_decay>
              <linear>0</linear>
              <angular>0</angular>
            </velocity_decay>
            <self_collide>0</self_collide>
            <kinematic>0</kinematic>
            <gravity>1</gravity>
          </link>
          <pose>190 0 0 0 0 0</pose>
        </model>

        <gravity>0 0 -9.7925</gravity>

        <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

        <atmosphere type='adiabatic'/>

        <physics name='default_physics' default='0' type='ode'>
            <max_step_size>0.001</max_step_size>
            <real_time_factor>1</real_time_factor>
            <real_time_update_rate>1000</real_time_update_rate>
        </physics>

        <scene>
          <sky>
            <clouds>
              <speed>12</speed>
            </clouds>
          </sky>
            <ambient>0.4 0.4 0.4 1</ambient>
            <background>0 0.6 0 0.8</background>
            <shadows>true</shadows>
        </scene>

        <audio>
            <device>default</device>
        </audio>

        <wind/>

        <spherical_coordinates>
            <surface_model>EARTH_WGS84</surface_model>
            <latitude_deg>0</latitude_deg>
            <longitude_deg>0</longitude_deg>
            <elevation>0</elevation>
            <heading_deg>0</heading_deg>
        </spherical_coordinates>

        <model name='power_tower'>
            <include>
                <uri>model://power_tower</uri>
                <pose> 0 0 0 0 0 0 </pose>
            </include>
        </model>

        <gui fullscreen='0'>
            <camera name='user_camera'>
                <pose frame=''>0 4 20 0 1.37964 -1.575</pose>
                <view_controller>orbit</view_controller>
                <projection_type>perspective</projection_type>
            </camera>
        </gui>
    </world>
</sdf>
